{
  "name": "vamos_${localWorkspaceFolderBasename}",
  "dockerFile": "Dockerfile",
  "initializeCommand": "mkdir -p \"$HOME/tmp/vamos-scratch\"",
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/worktrees,type=bind,consistency=cached",
  "workspaceFolder": "/worktrees/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "WORKSPACE_FOLDER": "/worktrees/${localWorkspaceFolderBasename}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "astro-build.astro-vscode",
        "bierner.markdown-mermaid",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "golang.go",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "openai.chatgpt",
        "streetsidesoftware.code-spell-checker",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "forwardPorts": [4321, 8787],
  "portsAttributes": {
    "4321": { "label": "docs: astro dev" },
    "8787": { "label": "docs: wrangler dev" }
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/tmp/vamos-scratch,target=/scratch,type=bind"
  ],
  "runArgs": [
    "--name=vamos_${localWorkspaceFolderBasename}",
    "--privileged"
  ]
}
